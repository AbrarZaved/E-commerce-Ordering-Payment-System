# ---- Django ----
# Single settings module (no more base/local/production split)
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me
# True enables debug, permissive hosts/CORS, console email, eager Celery.
# Set False in production to auto-enable HTTPS/HSTS hardening + SMTP email.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# DJANGO_DEBUG=True -> local SQLite (db.sqlite3), DATABASE_URL ignored.
# DJANGO_DEBUG=False -> PostgreSQL via DATABASE_URL below.
DATABASE_URL=postgres://ecommerce:ecommerce@db:5432/ecommerce

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Run Celery tasks synchronously (no worker needed). Defaults to DJANGO_DEBUG.
CELERY_TASK_ALWAYS_EAGER=True
CATEGORY_TREE_CACHE_TTL=3600
# Set True to use in-memory cache instead of Redis for quick local dev.
USE_LOCMEM_CACHE=False

# ---- JWT ----
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ---- CORS (frontend demo) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500
CORS_ALLOW_ALL_ORIGINS=True

# ---- Seed admin ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# ---- Email (SMTP; only used when DJANGO_DEBUG=False) ----
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@example.com

# ---- Stripe (test mode) ----
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# ---- bKash (sandbox) ----
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_sandbox_app_key
BKASH_APP_SECRET=your_sandbox_app_secret
BKASH_USERNAME=your_sandbox_username
BKASH_PASSWORD=your_sandbox_password
BKASH_WEBHOOK_SECRET=
